# dotenvx vault. No Mazel secrets service. Never commit .env or .env.keys.
#
#   cp .env.example .env
#   dotenvx set MAZEL_CARD_KAI -- cards/kai.json
#   dotenvx set MAZEL_CARD_OWNER -- cards/owner.json
#   dotenvx set MAZEL_CARD_NOVA -- cards/nova.json
#   dotenvx encrypt
#   dotenvx run -- mix human_demo
#   dotenvx run -- mix secrets_demo
#
# See docs/SECRETS.md

# Card vault (placeholders only — set via dotenvx, never paste values here)
# MAZEL_CARD_OWNER=
# MAZEL_CARD_KAI=
# MAZEL_CARD_NOVA=
# MAZEL_CARDS_DIR=

# Optional public edge
# MAZEL_PUBLIC_URL=

# Optional demo handles (not secrets)
# MAZEL_FROM=you
# MAZEL_PEER=kai
# MAZEL_KIND=direct
# MAZEL_TEXT=
